# Canonical host. Leave unset, or set to the preview URL, until launch.
# Setting this exact value allows indexing:
# NEXT_PUBLIC_SITE_URL=https://www.dermotcox.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry email. All three are required before the form will send.
# Use a verified sender that does not need a change to Dermot's mail DNS.
RESEND_API_KEY=
FROM_EMAIL=
CONTACT_TO=
